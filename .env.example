# Copy this file to .env and fill in real values, then run:
#   docker compose up -d --build
#
# NEXT_PUBLIC_* vars are baked into the client bundle at BUILD time, not
# read at runtime — after changing any of them you must rebuild the image
# (docker compose build web / docker compose up -d --build).

# --- App (Next.js) ---

# Canonical site URL, no trailing slash. Used for canonicals, OG tags, sitemap.
NEXT_PUBLIC_SITE_URL=https://ceriumchemicalsltd.com

# Cloudinary cloud name for image delivery. Leave empty to fall back to
# labelled development placeholder images.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Unused. Kept so an existing .env does not break; the admin is part of this
# Next.js app and there is no separate API service.
NEXT_PUBLIC_API_URL=

# --- Database (Postgres) ---
#
# Runs as the `db` service in docker-compose and is NOT published to the host,
# so it is reachable only from the compose network.
#
# DATABASE_URL is assembled from these three in docker-compose.yml. Set it
# directly only for local development against your own Postgres:
#   DATABASE_URL=postgres://cerium:devpassword@localhost:5432/cerium
#
# Leave DATABASE_URL unset and the site still runs — it falls back to the
# reviewed typed catalogue in src/data/. The admin needs a database.
POSTGRES_USER=cerium
POSTGRES_PASSWORD=
POSTGRES_DB=cerium
DATABASE_URL=

# --- Admin authentication (Auth.js) ---
#
# Signing key for session cookies. Generate with:
#   openssl rand -base64 32
# Changing it signs every admin out. Never commit a real value.
AUTH_SECRET=

# --- Cloudinary (server-side upload credentials) ---
#
# From the Cloudinary console: Settings -> API Keys. These are SECRET and are
# passed to the container at runtime, never as Docker build args, because a
# build arg is readable from the image history forever.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# "true" to allow search engines to index the site; anything else disallows.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Reverse proxy / TLS (Caddy) ---

# Domain Caddy requests a certificate for. Must have a Cloudflare DNS A/AAAA
# record pointing at this server's IP. If Cloudflare's proxy (orange cloud)
# is enabled, set SSL/TLS mode to "Full" or "Full (strict)" in Cloudflare.
DOMAIN=ceriumchemicalsltd.com

# Contact email for Let's Encrypt certificate/expiry notices.
ACME_EMAIL=
