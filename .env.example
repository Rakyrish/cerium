# =============================================================================
# CERIUM CHEMICALS — THE ONE CONFIGURATION FILE
# =============================================================================
#
#   cp .env.example .env
#
# This file is the single source of configuration for BOTH applications.
# There is no frontend/.env and no backend/.env — deleting those was the point.
#
#   frontend/  (Next.js)  reads it via next.config.ts and docker compose env_file
#   backend/   (Django)   reads it via config/settings.py -> environ.read_env()
#   docker-compose.yml    reads it directly for build args and container env
#
# Nothing in either codebase may hardcode a value that belongs here. If you
# find yourself typing a domain, a phone number, a colour or a key into a
# source file, it belongs in this file instead.
#
# -----------------------------------------------------------------------------
# TWO RULES THAT WILL BITE YOU IF YOU SKIP THEM
# -----------------------------------------------------------------------------
#
# 1. NEXT_PUBLIC_* IS INLINED AT BUILD TIME, NOT READ AT RUNTIME.
#    Changing one and restarting the container does nothing. The value was
#    baked into the JavaScript when the image was built. You must rebuild:
#        docker compose build web && docker compose up -d
#    Everything without the NEXT_PUBLIC_ prefix IS read at runtime.
#
# 2. THIS FILE IS COMMITTED. .env IS NOT.
#    The non-secret values below are real and correct, so a fresh clone works
#    immediately. Every secret is deliberately blank. Never fill a secret in
#    here — fill it in .env, which is gitignored.
#
# =============================================================================


# =============================================================================
# 1. DEPLOYMENT
# =============================================================================

# The public domain, without protocol. Caddy requests a TLS certificate for it
# and redirects www -> apex. Must have a DNS A/AAAA record pointing at this
# server. If Cloudflare's proxy (orange cloud) is on, set SSL/TLS mode to
# "Full" or "Full (strict)".
CERIUM_DOMAIN=ceriumchemicalsltd.com

# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=

# Canonical site URL, no trailing slash. Every canonical tag, OG url, sitemap
# entry and structured-data URL is built from this. It must match CERIUM_DOMAIN
# in production — a mismatch means the site advertises a domain it is not on.
NEXT_PUBLIC_SITE_URL=https://ceriumchemicalsltd.com

# Where the Next.js app reaches the Django API. Server-side only, so it uses
# the compose service name rather than the public domain — the request never
# leaves the container network.
DJANGO_API_URL=http://backend:8000


# =============================================================================
# 2. SEARCH ENGINE INDEXING
# =============================================================================
#
# "true" allows indexing. Anything else — including unset — disallows
# everything via robots.txt.
#
# The default is false on purpose and must stay false. An indexed staging site
# competing with production is far harder to undo than a temporarily blocked
# production site is to notice.
#
#   production:  true, then rebuild the image
#   staging:     false
#
# Verify after every deploy rather than assuming:
#   curl -s https://<domain>/robots.txt
# Expect "Allow: /" and the "Sitemap:" line. If it says "Disallow: /", the
# image was built without this set.
NEXT_PUBLIC_ALLOW_INDEXING=false


# =============================================================================
# 3. COMPANY IDENTITY
# =============================================================================
#
# These appear in the page title template, the footer, structured data and the
# social share image. They are taken from supplied Cerium material (2026
# catalogue back cover, Q3 2026 fragrance price list footer, and the current
# live site). Nothing here is invented — do not "improve" the wording without
# a Cerium document to point at.

NEXT_PUBLIC_COMPANY_NAME=Cerium Chemicals

# Part of the supplied logo lockup.
NEXT_PUBLIC_COMPANY_TAGLINE=Sourcing made easy

# Verbatim from the 2026 catalogue "About Us". Note the live WordPress site
# also lists food ingredients; the 2026 catalogue does not, so food is
# deliberately excluded pending Cerium's confirmation.
NEXT_PUBLIC_COMPANY_DESCRIPTION=Cerium Chemicals is a customer-oriented company focused on delivering raw material solutions to the personal care and home care industries.

# The strapline drawn on the generated social share image.
NEXT_PUBLIC_COMPANY_STRAPLINE=Specialty raw materials for personal care and home care

# Region Cerium states that it serves, used in Organization structured data.
NEXT_PUBLIC_COMPANY_AREA_SERVED=East and Central Africa


# =============================================================================
# 4. CONTACT
# =============================================================================
#
# Catalogue back cover + fragrance price list footer.

# As displayed to a human, spacing and all.
NEXT_PUBLIC_CONTACT_PHONE=+254 724 532 892

# The same number in E.164, digits only, no "+". Used to build the tel: and
# WhatsApp links, so the displayed and dialled numbers cannot drift apart.
NEXT_PUBLIC_CONTACT_PHONE_E164=254724532892

NEXT_PUBLIC_CONTACT_EMAIL=hello@ceriumchemicals.co.ke


# =============================================================================
# 5. ADDRESS
# =============================================================================
#
# Catalogue back cover. Feeds the PostalAddress in Organization structured
# data, so it must be the real registered trading address.

NEXT_PUBLIC_ADDRESS_STREET=Bamburi Road, Building 22, Off Enterprise Road
NEXT_PUBLIC_ADDRESS_LOCALITY=Industrial Area
NEXT_PUBLIC_ADDRESS_REGION=Nairobi
NEXT_PUBLIC_ADDRESS_COUNTRY=Kenya

# ISO 3166-1 alpha-2. Structured data expects the code, not the name.
NEXT_PUBLIC_ADDRESS_COUNTRY_CODE=KE


# =============================================================================
# 6. OPENING HOURS
# =============================================================================
#
# Format:  <days>|<time>  , entries separated by  ;
# Whitespace around the separators is ignored. Leave empty to publish no hours
# rather than guessing them.
#
# As published on the current live site.
NEXT_PUBLIC_OPENING_HOURS=Monday – Friday|8:30 AM – 6:00 PM; Saturday|8:30 AM – 2:00 PM


# =============================================================================
# 7. SOCIAL PROFILES
# =============================================================================
#
# Only fill in a URL that has been CONFIRMED by Cerium. An empty value renders
# nothing and is omitted from the `sameAs` array in structured data, which is
# correct — a guessed profile URL in sameAs is a factual claim about an account
# that may not be Cerium's.
#
# WhatsApp is derived from NEXT_PUBLIC_CONTACT_PHONE_E164 and needs no entry.
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/ceriumchemicals/
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/cerium_chemicals/
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://ke.linkedin.com/jobs/view/technical-sales-intern-at-cerium-chemicals-4241884090


# =============================================================================
# 8. BRAND
# =============================================================================
#
# Green is the primary identity, taken from the 2026 printed catalogue.
#
# QUOTE EVERY COLOUR. An unquoted value starting with "#" is read as an empty
# string, because "#" begins a comment — dotenv and django-environ both do this,
# and both do it silently. The quotes are not decoration.
#
# THEME_COLOR must equal --color-green-600 in frontend/src/app/globals.css.
# CSS cannot read this file, so the design token is declared there and consumed
# here by the browser theme colour, the web manifest and the social image.
# Changing one means changing both; globals.css says so at the token.
NEXT_PUBLIC_BRAND_THEME_COLOR="#21683f"

# Light tint used for text on the brand-green social image.
NEXT_PUBLIC_BRAND_ON_DARK_COLOR="#e8f3ec"

# Splash/background colour for the installed web app.
NEXT_PUBLIC_BRAND_BACKGROUND_COLOR="#ffffff"

# Paths under frontend/public/. The inverse is the monochrome reversal, for
# dark surfaces.
NEXT_PUBLIC_BRAND_LOGO=/brand/cerium-logo.png
NEXT_PUBLIC_BRAND_LOGO_INVERSE=/brand/cerium-logo-white.png
NEXT_PUBLIC_BRAND_LOGO_WIDTH=800
NEXT_PUBLIC_BRAND_LOGO_HEIGHT=250


# =============================================================================
# 9. LOCALE
# =============================================================================

# OpenGraph locale, underscore form.
NEXT_PUBLIC_SITE_LOCALE=en_KE

# The <html lang> attribute and structured-data inLanguage.
NEXT_PUBLIC_SITE_LANGUAGE=en

# Django equivalents, hyphen form and IANA zone.
DJANGO_LANGUAGE_CODE=en-ke
DJANGO_TIME_ZONE=Africa/Nairobi


# =============================================================================
# 10. DATABASES
# =============================================================================
#
# TWO DATABASES, AND THEY MUST STAY SEPARATE.
#
# Django owns its schema through Django migrations. The Next.js app still
# carries a Drizzle schema with its own migration history. Two migration
# systems must never be pointed at one database: each believes it owns the
# table definitions and neither reads the other's history table.
#
# The frontend cutover to the Django API is Phase 2.4C. Until then both exist.

POSTGRES_USER=cerium
POSTGRES_PASSWORD=
POSTGRES_DB=cerium

# Django's database. Note the DIFFERENT database name.
POSTGRES_DJANGO_DB=cerium_production

# Assembled by docker-compose from the values above. Set these directly only
# for local development against your own Postgres:
#   DATABASE_URL=postgres://cerium:devpassword@localhost:5432/cerium
#   DJANGO_DATABASE_URL=postgres://cerium:devpassword@localhost:5432/cerium_production
#
# Leave DATABASE_URL empty and the public site still runs — it falls back to
# the reviewed typed catalogue in frontend/src/data/. The admin needs a database.
DATABASE_URL=
DJANGO_DATABASE_URL=


# =============================================================================
# 11. SECRETS
# =============================================================================
#
# Every value in this section is blank here and must stay blank. Fill them in
# .env only. They are passed to containers at RUNTIME, never as Docker build
# args — a build arg is readable from the image history forever.

# Shared secret proving a credential-verification request came from the Next.js
# server. Both applications read this one variable — that is the point.
#
# ONE SET OF LOGINS. Admin accounts live in Django's auth_user table and
# nowhere else, so the same username/email and password work at /admin
# (Next.js) and /django-admin/ (Django). Create them with:
#     cd backend && .venv/bin/python manage.py create_admin
#
# This token authenticates the CALLER of /api/admin/auth/verify/, which is a
# password oracle. It is never routed from the internet (Caddy publishes only
# /api/public/*), but the token is the second lock. Generate with:
#     openssl rand -hex 32
# Unset means sign-in refuses outright rather than proceeding unauthenticated.
ADMIN_AUTH_SERVICE_TOKEN=

# Next.js admin session signing key (Auth.js).
#   openssl rand -base64 32
# Changing it signs every admin out.
AUTH_SECRET=

# Django signing key. There is no fallback in settings.py on purpose: a
# settings module that boots with a default key is one that eventually ships
# with it.
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Never true in production. Debug pages print settings, including secrets.
DJANGO_DEBUG=False

# Comma-separated. Django refuses requests for any Host not listed.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,ceriumchemicalsltd.com,www.ceriumchemicalsltd.com


# =============================================================================
# 12. CLOUDINARY — product media
# =============================================================================
#
# Product images are transferred into Cerium's own Cloudinary account and
# served from there. A production catalogue must never depend on a third
# party's URL staying alive and unchanged.
#
# The cloud name is public (it appears in every image URL). The key and secret
# are not: from the Cloudinary console, Settings -> API Keys.
#
# Leave the cloud name empty and CeriumImage falls back to a visibly labelled
# "Image pending" placeholder, which is the honest behaviour.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=pwnff5q7
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder every Cerium asset lands in, so the account stays navigable.
CLOUDINARY_FOLDER=cerium


# =============================================================================
# 13. OPENAI — editorial content generation
# =============================================================================
#
# Only content generation needs this. Migrations, the product editor,
# publishing and the whole public API work without it, and generation fails
# with a clear message rather than degrading into something worse.
#
# The model is an assistant, never a source of product information. See
# backend/catalogue/services/ai_content.py for what enforces that.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
