# Enforce the "engines" field in package.json instead of only warning about it.
#
# Next.js 16 requires Node >= 20.9. Without this, npm on an older Node prints a
# skippable EBADENGINE warning and carries on — which is how a lockfile written
# by npm 10+ ends up silently rewritten (and degraded) by npm 9.
#
# The Node version to use is pinned in .nvmrc and must match ARG NODE_VERSION
# in the Dockerfile.
engine-strict=true
